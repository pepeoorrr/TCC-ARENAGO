generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==================== USUARIOS ====================
model Usuario {
  id              String   @id @default(cuid())
  nome            String
  email           String   @unique
  senha           String
  telefone        String?
  cpf             String?  @unique
  endereco        String?
  perfil          Perfil   @default(CLIENTE)
  ativo           Boolean  @default(true)
  dataCriacao     DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  // Relacionamentos
  reservas           Reserva[]
  reservasCanceladas Reserva[]   @relation("ReservaCanceladaPor")
  comandas           Comanda[]
  bloqueios          Bloqueio[]
  historicos         Historico[]

  @@map("usuarios")
}

enum Perfil {
  CLIENTE
  FUNCIONARIO
  ADMIN
}

// ==================== QUADRAS ====================
model Quadra {
  id                    String     @id @default(cuid())
  nome                  String
  tipo                  TipoQuadra
  descricao             String?
  tamanho               String?
  capacidade            Int
  precoHora             Decimal    @db.Decimal(10, 2)
  horarioInicio         String
  horarioFim            String
  durationPadraoMinutos Int        @default(60)
  ativa                 Boolean    @default(true)
  dataCriacao           DateTime   @default(now())
  dataAtualizacao       DateTime   @updatedAt

  // Relacionamentos
  reservas  Reserva[]
  bloqueios Bloqueio[]

  @@map("quadras")
}

enum TipoQuadra {
  FUTSAL
  VOLEI
  BASQUETE
  TENIS
  OUTRO
}

// ==================== RESERVAS ====================
model Reserva {
  id                 String        @id @default(cuid())
  numeroReserva      String        @unique
  usuarioId          String
  quadraId           String
  dataReserva        DateTime
  horarioInicio      String
  horarioFim         String
  status             StatusReserva @default(CONFIRMADA)
  motivoCancelamento String?
  canceladaPorId     String?
  valorAluguel       Decimal       @db.Decimal(10, 2)
  dataCriacao        DateTime      @default(now())
  dataAtualizacao    DateTime      @updatedAt

  // Relacionamentos
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  quadra       Quadra   @relation(fields: [quadraId], references: [id], onDelete: Cascade)
  comanda      Comanda?
  canceladaPor Usuario? @relation("ReservaCanceladaPor", fields: [canceladaPorId], references: [id])

  @@index([usuarioId])
  @@index([quadraId])
  @@index([status])
  @@map("reservas")
}

enum StatusReserva {
  CONFIRMADA
  ATIVA
  FINALIZADA
  CANCELADA
}

// ==================== COMANDAS ====================
model Comanda {
  id               String        @id @default(cuid())
  numeroComanda    String        @unique
  reservaId        String        @unique
  usuarioId        String
  status           StatusComanda @default(ABERTA)
  subtotalConsumos Decimal       @default(0) @db.Decimal(10, 2)
  valorAluguel     Decimal       @db.Decimal(10, 2)
  total            Decimal       @db.Decimal(10, 2)
  formaPagamento   String?
  valorPago        Decimal?      @db.Decimal(10, 2)
  troco            Decimal?      @db.Decimal(10, 2)
  observacoes      String?       @db.Text
  dataFechamento   DateTime?
  dataPagamento    DateTime?
  dataCriacao      DateTime      @default(now())
  dataAtualizacao  DateTime      @updatedAt

  // Relacionamentos
  reserva Reserva       @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  usuario Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  itens   ItemComanda[]

  @@index([usuarioId])
  @@index([status])
  @@map("comandas")
}

enum StatusComanda {
  ABERTA
  FECHADA
  AGUARDANDO_PAGAMENTO
  PAGA
  CANCELADA
}

// ==================== ITENS_COMANDA ====================
model ItemComanda {
  id            String   @id @default(cuid())
  comandaId     String
  produtoId     String
  quantidade    Int
  precoUnitario Decimal  @db.Decimal(10, 2)
  subtotal      Decimal  @db.Decimal(10, 2)
  dataCriacao   DateTime @default(now())

  // Relacionamentos
  comanda Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([comandaId])
  @@index([produtoId])
  @@map("itens_comanda")
}

// ==================== PRODUTOS ====================
model Produto {
  id              String   @id @default(cuid())
  nome            String
  descricao       String?  @db.Text
  categoriaId     String
  preco           Decimal  @db.Decimal(10, 2)
  estoqueAtual    Int
  estoqueMinimo   Int      @default(5)
  ativo           Boolean  @default(true)
  dataCriacao     DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  // Relacionamentos
  categoria    Categoria     @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  itensComanda ItemComanda[]

  @@index([categoriaId])
  @@map("produtos")
}

// ==================== CATEGORIAS ====================
model Categoria {
  id          String   @id @default(cuid())
  nome        String   @unique
  descricao   String?  @db.Text
  ativa       Boolean  @default(true)
  dataCriacao DateTime @default(now())

  // Relacionamentos
  produtos Produto[]

  @@map("categorias")
}

// ==================== BLOQUEIOS ====================
model Bloqueio {
  id            String         @id @default(cuid())
  quadraId      String
  dataBloqueio  DateTime
  horarioInicio String
  horarioFim    String
  motivo        MotivoBloqueio
  criadoPorId   String
  dataCriacao   DateTime       @default(now())

  // Relacionamentos
  quadra    Quadra  @relation(fields: [quadraId], references: [id], onDelete: Cascade)
  criadoPor Usuario @relation(fields: [criadoPorId], references: [id], onDelete: Cascade)

  @@index([quadraId])
  @@index([dataBloqueio])
  @@map("bloqueios")
}

enum MotivoBloqueio {
  MANUTENCAO
  LIMPEZA
  EVENTO
  OUTRO
}

// ==================== HISTORICO ====================
model Historico {
  id              String   @id @default(cuid())
  usuarioId       String
  tipoAcao        TipoAcao
  entidade        String
  entidadeId      String
  descricao       String   @db.Text
  dadosAnteriores String?  @db.LongText
  dadosNovos      String?  @db.LongText
  ipAddress       String?
  dataAcao        DateTime @default(now())

  // Relacionamentos
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([dataAcao])
  @@map("historico")
}

enum TipoAcao {
  CRIACAO
  EDICAO
  DELECAO
  PAGAMENTO
  CANCELAMENTO
}
