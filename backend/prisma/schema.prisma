// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum PerfilUsuario {
  ADMIN
  RECEPCIONISTA
  CLIENTE
}

enum TipoQuadra {
  BEACH_TENNIS
  VOLEI_PRAIA
  FUTEBOL_SOCIETY
}

enum StatusReserva {
  PENDENTE
  CONFIRMADA
  CANCELADA
  CONCLUIDA
}

enum StatusComanda {
  ABERTA
  FECHADA
  CANCELADA
}

enum StatusProduto {
  ATIVO
  INATIVO
}

model Usuario {
  id           String        @id @default(uuid()) @db.VarChar(36)
  email        String        @unique @db.VarChar(255)
  senhaHash    String        @map("senha_hash") @db.VarChar(255)
  perfil       PerfilUsuario @default(CLIENTE)
  ativo        Boolean       @default(true)
  criadoEm    DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")

  reservas  Reserva[]
  comandas  Comanda[]

  @@map("usuario")
}

model Quadra {
  id        String     @id @default(uuid()) @db.VarChar(36)
  nome      String     @db.VarChar(120)
  tipo      TipoQuadra
  valorHora Decimal    @map("valor_hora") @db.Decimal(10, 2)
  ativa     Boolean    @default(true)
  criadoEm DateTime   @default(now()) @map("criado_em")

  reservas  Reserva[]

  @@map("quadra")
}

model Reserva {
  id            String        @id @default(uuid()) @db.VarChar(36)
  idCliente     String        @map("id_cliente") @db.VarChar(36)
  idQuadra      String        @map("id_quadra") @db.VarChar(36)
  data          DateTime      @db.Date
  horarioInicio DateTime      @map("horario_inicio") @db.Time(0)
  horarioFim    DateTime      @map("horario_fim")    @db.Time(0)
  duracaoMin    Int           @map("duracao_min")
  status        StatusReserva @default(PENDENTE)
  criadoEm    DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")

  cliente  Usuario  @relation(fields: [idCliente], references: [id])
  quadra   Quadra   @relation(fields: [idQuadra],  references: [id])
  comanda  Comanda?

  @@unique([idQuadra, data, horarioInicio], name: "sem_sobreposicao_quadra")
  @@index([idCliente])
  @@index([data])
  @@map("reserva")
}

model Comanda {
  id        String        @id @default(uuid()) @db.VarChar(36)
  idReserva String?       @unique @map("id_reserva") @db.VarChar(36)
  idCliente String        @map("id_cliente") @db.VarChar(36)
  status    StatusComanda @default(ABERTA)
  total     Decimal       @default(0) @db.Decimal(10, 2)
  criadoEm DateTime      @default(now()) @map("criado_em")
  fechadoEm DateTime?    @map("fechado_em")

  reserva  Reserva?      @relation(fields: [idReserva], references: [id])
  cliente  Usuario       @relation(fields: [idCliente], references: [id])
  itens    ComandaItem[]

  @@index([idCliente])
  @@map("comanda")
}

model Produto {
  id                String        @id @default(uuid()) @db.VarChar(36)
  nome              String        @db.VarChar(120)
  preco             Decimal       @db.Decimal(10, 2)
  quantidadeEstoque Int           @default(0) @map("quantidade_estoque")
  status            StatusProduto @default(ATIVO)
  criadoEm        DateTime      @default(now()) @map("criado_em")
  atualizadoEm    DateTime      @updatedAt @map("atualizado_em")

  itens  ComandaItem[]

  @@map("produto")
}

model ComandaItem {
  id        String  @id @default(uuid()) @db.VarChar(36)
  idComanda String  @map("id_comanda") @db.VarChar(36)
  idProduto String  @map("id_produto") @db.VarChar(36)
  quantidade Int
  precoUnit Decimal @map("preco_unit") @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  comanda  Comanda @relation(fields: [idComanda], references: [id])
  produto  Produto @relation(fields: [idProduto], references: [id])

  @@index([idComanda])
  @@map("comanda_item")
}
