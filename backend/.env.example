# Copie este arquivo para backend/.env e preencha os valores necessários.

# Obrigatória: conexão MySQL utilizada pela API e pelos comandos do Prisma.
# Codifique caracteres especiais do usuário/senha na URL (ex.: @ como %40).
DATABASE_URL="mysql://usuario:senha@localhost:3306/arenago"

# Obrigatória: segredo de assinatura dos tokens JWT (mínimo de 16 caracteres).
# Gere um valor aleatório e exclusivo para cada ambiente, por exemplo:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Opcionais: ambiente de execução, porta da API e origem autorizada no CORS.
# Em produção, use NODE_ENV=production e a URL real do frontend.
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Opcional: servidor MySQL para npm run test:integration.
# O usuário precisa de permissão para criar e remover bancos temporários.
# O runner cria arenago_<uuid>_test e remove somente a base que criou.
# Se vazio, utiliza o servidor de DATABASE_URL, sempre com uma base separada.
# Exemplo para MySQL local: mysql://usuario:senha@127.0.0.1:33316/arenago_test
TEST_DATABASE_URL=""

# Somente para criar o primeiro administrador com npm run admin:create.
# ADMIN_EMAIL e ADMIN_PASSWORD são obrigatórias para esse comando;
# ADMIN_PASSWORD deve ter no mínimo 8 caracteres.
# ADMIN_NAME é opcional (padrão: Administrador).
# Remova as credenciais de bootstrap do .env após criar o administrador.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"
